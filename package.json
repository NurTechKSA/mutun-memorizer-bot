{
  "name": "mutun-memorizer-bot",
  "version": "1.0.0",
  "description": "Telegram bot for gradual memorization of short mutun with PDF page images and audio.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "content:fetch": "tsx scripts/fetch-content.ts",
    "content:prepare": "tsx scripts/prepare-content.ts",
    "content:import:hifzun": "tsx scripts/import-hifzun-content.ts",
    "content:text:extract": "node scripts/extract-page-text.mjs",
    "audio:template": "tsx scripts/create-audio-timing-template.ts",
    "audio:report": "tsx scripts/audit-audio-alignment.ts",
    "telegram:hifzun:scan": "tsx scripts/hifzun-scan.ts",
    "state:migrate-trimmed-pages": "tsx scripts/migrate-trimmed-page-indexes.ts",
    "updatedesk:note": "node tools/updatedesk-note.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "telegram",
    "mutun",
    "memorization"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "node-cron": "^4.6.0",
    "pngjs": "^7.0.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
