  "pages": [
    {
      "sourcePageNumber": 39,
      "start": "بسم الله الرحمن الرحيم تفت فؤادك الأيام فتا",
      "end": "متى لا ترعوي عنها وحتى",
      "reviewNote": "Проверено вручную: клип начинается с басмалы (вступление диктора отрезано), бейт 1 звучит на 30.5–40 с; автоматическая проверка его не видит, т.к. Whisper пропускает этот бейт."
    },
    {
      "sourcePageNumber": 40,
      "start": "أبا بكر دعوتك لو أجبتا",
      "end": "تصيب به مقاتل من ضربتا"
    },
    {
      "sourcePageNumber": 41,
      "start": "وكنز لا تخاف عليه لصا",
      "end": "فإن أعطاكه الله أخذتا"
    },
    {
      "sourcePageNumber": 42,
      "start": "وإن أوتيت فيه طول باع",
      "end": "فليتك ثم ليتك ما فهمتا"
    },
    {
      "sourcePageNumber": 43,
      "start": "ستجني من ثمار العجز جهلا",
      "end": "فما بالبطء تدرك ما طلبتا"
    },
    {
      "sourcePageNumber": 44,
      "start": "ولا تحفل بمالك واله عنه",
      "end": "ستعلمه إذا طه قرأتا"
    },
    {
      "sourcePageNumber": 45,
      "start": "لئن رفع الغني لواء مال",
      "end": "إذا بفناء طاعته أنختا"
    },
    {
      "sourcePageNumber": 46,
      "start": "فقابل بالقبول صحيح نصحي",
      "end": "وتاجرت الإله به ربحتا"
    },
    {
      "sourcePageNumber": 47,
      "start": "فليست هذه الدنيا بشيء",
      "end": "كأنك لا تراد بما شهدتا"
    },
    {
      "sourcePageNumber": 48,
      "start": "ولم تخلق لتعمرها ولكن",
      "end": "ولا تدري أتفدى أم غلقتا"
    },
    {
      "sourcePageNumber": 49,
      "start": "وسل من ربك التوفيق فيها",
      "end": "لتذكر في السماء إذا ذكرتا"
    },
    {
      "sourcePageNumber": 50,
      "start": "ولا تقل الصبا فيه مجال",
      "end": "كما قد خضته حتى غرقتا"
    },
    {
      "sourcePageNumber": 51,
      "start": "ولم أشرب حميا أم دفر",
      "end": "ولو سكت المسيء لما نطقتا"
    },
    {
      "sourcePageNumber": 52,
      "start": "ونفسك ذم لا تذمم سواها",
      "end": "لعمرك لو وصلت لما رجعتا"
    },
    {
      "sourcePageNumber": 53,
      "start": "ولو وافيت ربك دون ذنب",
      "end": "وليس كما حسبت ولا ظننتا"
    },
    {
      "sourcePageNumber": 54,
      "start": "أبا بكر كشفت أقل عيبي",
      "end": "وتجعلك القريب وإن بعدتا"
    },
    {
      "sourcePageNumber": 55,
      "start": "وتنشر عنك في الدنيا جميلا",
      "end": "وكيف لك الفكاك وقد أسرتا"
    },
    {
      "sourcePageNumber": 56,
      "start": "وخف أبناء جنسك واخش منهم",
      "end": "وشرق إن بريقك قد شرقتا"
    },
    {
      "sourcePageNumber": 57,
      "start": "فليس الزهد في الدنيا خمولا",
      "end": "بإجلال فنفسك قد أهنتا"
    },
    {
      "sourcePageNumber": 58,
      "start": "جمعت لك النصائح فامتثلها",
      "end": "وكانت قبل ذا مئة وستا تمت بحمد الله",
      "reviewNote": "Страница добавлена: бейты 110–113 и «تمت بحمد الله» были за пределами studyRange (PDF 58)."
    }
  ]
}
